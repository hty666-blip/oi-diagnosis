# ---- 应用 ----
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- MySQL ----
# MySQL 8.4；密码中的特殊字符需进行 URL 编码。
MYSQL_PORT=3307
MYSQL_DATABASE=oi_diagnosis
MYSQL_USER=gesp_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
DATABASE_URL=mysql+asyncmy://gesp_user:change-me@127.0.0.1:3307/oi_diagnosis?charset=utf8mb4&connect_timeout=5

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- MinIO ----
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=oi-diag
MINIO_SECURE=false

# ---- 沙箱 ----
JUDGE_BACKEND=docker
JUDGE_PORT=5050
JUDGE_URL=http://localhost:5050
JUDGE_TOKEN=
# Docker Hub 或 Debian 软件源访问受限时可按本机环境覆盖构建参数。
JUDGE_BASE_IMAGE=criyle/go-judge:v1.13.3
DEBIAN_MIRROR=
JUDGE_WORKER_ENABLED=true
JUDGE_WORKER_HEARTBEAT_SECONDS=5
JUDGE_WORKER_POLL_SECONDS=0.5
JUDGE_JOB_LEASE_SECONDS=30
JUDGE_JOB_TIMEOUT_SECONDS=120
JUDGE_JOB_MAX_ATTEMPTS=3
JUDGE_JOB_MAX_MANUAL_RETRIES=2

# ---- 备份维护（空 URL 时允许加密备份，关闭恢复验证）----
MAINTENANCE_WORKER_ENABLED=true
# 可留空，默认 data/private/backups；密钥单独保存在相邻 backup.key。
BACKUP_DIRECTORY=
# 同一 MySQL 的专用空库，库名须含 _restore_，不得指向业务库。
BACKUP_VERIFY_DATABASE_URL=

# ---- 模型（走 OpenAI 兼容协议，具体供应商在代码里按逻辑名路由）----
LLM_API_BASE=https://api.example.com/v1
LLM_ENABLED=false
LLM_API_KEY=sk-replace-me
LLM_MODEL_FAST=
LLM_MODEL_REASONING=

# ---- 安全 ----
JWT_SECRET=dev-only-change-me
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
