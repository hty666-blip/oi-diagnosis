# ---- 应用 ----
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- PostgreSQL ----
POSTGRES_USER=oiuser
POSTGRES_PASSWORD=oipass
POSTGRES_DB=oidiag
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://oiuser:oipass@localhost:5432/oidiag

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- MinIO ----
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=oi-diag
MINIO_SECURE=false

# ---- 沙箱 ----
JUDGE_PORT=5050
JUDGE_URL=http://localhost:5050
JUDGE_TOKEN=

# ---- 模型（走 OpenAI 兼容协议，具体供应商在代码里按逻辑名路由）----
LLM_API_BASE=https://api.example.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL_FAST=
LLM_MODEL_REASONING=

# ---- 安全 ----
JWT_SECRET=dev-only-change-me
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
